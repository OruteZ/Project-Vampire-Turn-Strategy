      - rid: 7201578077006332004
  - m_Id: 3991484035107
    m_Localized: "{0} \uC804\uC0AC. \uBE5B \uC18D\uC5D0\uC11C \uC4F0\uB7EC\uC838
      \uBCC0\uC774\uD558\uC9C0 \uC54A\uB294\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035108
    m_Localized: "{0:josa(\uC774|\uAC00)} \uC4F0\uB7EC\uC84C\uB2E4. \uB2E4\uC74C
      \uC801 \uD398\uC774\uC988\uC5D0 \uC2A4\uD3F0\uC73C\uB85C \uC77C\uC5B4\uB09C\uB2E4!"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035109
    m_Localized: "\uBCF4\uB984\uB2EC\uC774 \uB5B4\uB2E4!"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035110
    m_Localized: "\uB2EC\uBE5B\uC5D0 \uAD00\uC774 \uC5F4\uB838\uB2E4. {0:josa(\uC774|\uAC00)}
      \uAE68\uC5B4\uB0AC\uB2E4!"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035111
    m_Localized: "\uAD00\uC774 \uC5F4\uB838\uB2E4"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035112
    m_Localized: "{0:josa(\uC774|\uAC00)} \uBC40\uD30C\uC774\uC5B4 \uC2A4\uD3F0\uC73C\uB85C
      \uC77C\uC5B4\uB0AC\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035113
    m_Localized: "\uBCF4\uB984\uB2EC\uC774 \uCC28 \uC788\uB2E4. {0:josa(\uC740|\uB294)}
      \uACC1\uC5D0 \uC544\uBB34\uB3C4 \uC5C6\uC5B4 \uAD76\uC8FC\uB9B0 \uCC44 \uB2E4\uAC00\uC628\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035114
    m_Localized: "\uBCF4\uB984\uB2EC\uC774 \uB2E4\uAC00\uC628\uB2E4. \uB2E4\uC74C
      \uC801 \uD134\uC5D0 {0:josa(\uC740|\uB294)} {1:josa(\uC744|\uB97C)} \uB178\uB9B0\uB2E4.
      \uBC94\uC704 \uBC16\xB7\uBE5B \uC18D\uC73C\uB85C \uBE7C\uAC70\uB098 \uCC98\uCE58\uD558\uBA74
      \uD761\uD608\uC740 \uC2E4\uD328\uD55C\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035115
    m_Localized: "\uBCF4\uB984\uB2EC"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035116
    m_Localized: "\uBCF4\uB984\uB2EC \uC544\uB798 {0:josa(\uC774|\uAC00)} {1:josa(\uC744|\uB97C)}
      \uBA39\uC5B4\uCE58\uC6E0\uB2E4!"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035117
    m_Localized: "\uD761\uD608"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035118
    m_Localized: "\uB2EC\uC774 \uC84C\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035119
    m_Localized: "\uB178\uB9AC\uB358 \uC544\uAD70\uC774 \uC774\uBBF8 \uC5C6\uB2E4"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035120
    m_Localized: "{0:josa(\uC774|\uAC00)} \uBE5B \uC18D\uC5D0 \uC788\uB2E4"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035121
    m_Localized: "{0:josa(\uC774|\uAC00)} \uC190\uC774 \uB2FF\uC9C0 \uC54A\uB294
      \uACF3\uC5D0 \uC788\uB2E4"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035122
    m_Localized: "\uBCF4\uB984\uB2EC\uC774 \uB5B4\uC9C0\uB9CC {0}. \uD761\uD608 \uC2E4\uD328.
      {1:josa(\uC774|\uAC00)} \uAD76\uC8FC\uB9B0 \uCC44 \uB364\uBCBC\uB4E0\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035123
    m_Localized: "\uD761\uD608 \uC2E4\uD328"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035124
    m_Localized: "{0}\uC758 \uCC3D\uBCBD \u2192 {1} 1 \uD53C\uD574"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035125
    m_Localized: "{0}: \uBC30\uCE58 \uAD6C\uC5ED\uC758 \uBE48 \uCE78\uC744 \uB20C\uB7EC
      \uBC30\uCE58\uD569\uB2C8\uB2E4. \uBC30\uCE58\uB41C \uC720\uB2DB\uC740 \uB04C\uC5B4\uC11C
      \uC62E\uAE30\uAC70\uB098 \uBC14\uAFC9\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035126
    m_Localized: "\uC801\uC774 \uD589\uB3D9\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035127
    m_Localized: "\uC804\uD22C\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035128
    m_Localized: "\uC544\uAD70\uC744 \uB20C\uB7EC \uC120\uD0DD\uD558\uC138\uC694.
      \uC801\uC774\uB098 \uC2DC\uC2E0\uC744 \uB204\uB974\uBA74 \uC815\uBCF4\uC640
      \uC704\uD611 \uBC94\uC704\uB97C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035129
    m_Localized: "\uD770 \uC810\uC120 \uACE0\uB9AC\uC758 \uC544\uAD70\uC744 \uB204\uB974\uBA74
      \uCC98\uCE58\uD569\uB2C8\uB2E4. \uB2E4\uB978 \uACF3\uC744 \uB204\uB974\uBA74
      \uCDE8\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035130
    m_Localized: "\uC774 \uC720\uB2DB\uC740 \uD589\uB3D9\uC744 \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035131
    m_Localized: "\uBC1D\uC740 \uCE78\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.
      \uBD89\uC740 \uCE78\uC758 \uC801\uC744 \uB204\uB974\uBA74 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035132
    m_Localized: "\uBD89\uC740 \uCE78\uC758 \uC801\uC744 \uB204\uB974\uBA74 \uACF5\uACA9\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 7201578077006332004
  - m_Id: 3991484035133
    m_Localized: "\uB2E4\uC74C \uD134 \uBCF4\uB984\uB2EC"
    m_Metadata:
