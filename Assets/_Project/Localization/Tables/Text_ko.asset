      - rid: 7201578077006332004
  - m_Id: 3991484035138
    m_Localized: "\uBCF4\uB984\uB2EC \uD761\uD608\uC744 \uD55C \uBC88\uB3C4 \uD5C8\uC6A9\uD558\uC9C0
