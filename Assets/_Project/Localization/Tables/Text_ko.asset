      - rid: 7201578077006332004
  - m_Id: 3991484035106
    m_Localized: "{0} \uC804\uC0AC. \uD558\uC218\uC778\uC5D0\uAC8C \uC4F0\uB7EC\uC838
      \uBCC0\uC774\uD558\uC9C0 \uC54A\uB294\uB2E4."
