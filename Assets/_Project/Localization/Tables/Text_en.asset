    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 5832192094208
    m_Localized: The Ruined Chapel
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 5832192094209
    m_Localized: The lord has sent swordsmen. Two walls divide the chapel, and only
      the middle aisle catches the dawn through a gap in the roof.
    m_Metadata:
