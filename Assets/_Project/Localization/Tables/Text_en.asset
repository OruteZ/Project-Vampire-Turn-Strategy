      - rid: 7201578077006332005
  - m_Id: 3991484035073
    m_Localized: It is not the {0} phase.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035074
    m_Localized: This unit type is not available in this chapter.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035075
    m_Localized: You cannot deploy on this hex.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035076
    m_Localized: Not enough population. Drag a deployed unit out of the zone to recall
      it.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035077
    m_Localized: Not enough silver.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035078
    m_Localized: No ally to recall.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035079
    m_Localized: No ally to move.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035080
    m_Localized: Recalled {0}.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035081
    m_Localized: No allies deployed.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035082
    m_Localized: 'Battle begins. Objective: defeat {0}.'
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035083
    m_Localized: "Turn {0} \xB7 Player Phase"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035084
    m_Localized: "Turn {0} \xB7 Enemy Phase"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035085
    m_Localized: "\u2014 Turn {0} Player Phase \u2014"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035086
    m_Localized: "\u2014 Turn {0} Enemy Phase \u2014"
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035087
    m_Localized: This unit cannot move.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035088
    m_Localized: You cannot move there.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035089
    m_Localized: You cannot attack that.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035090
    m_Localized: '{0} cleaves through and may attack again.'
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035091
    m_Localized: You cannot mercy kill that unit.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035092
    m_Localized: Mercy Kill
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035093
    m_Localized: No unit to wait.
    m_Metadata:
      m_Items:
      - rid: 7201578077006332005
  - m_Id: 3991484035094
    m_Localized: Bane
    m_Metadata:
