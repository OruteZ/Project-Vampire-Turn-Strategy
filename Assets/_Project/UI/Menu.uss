/* docs/ui/main-menu.md. Sizes are 1920x1080 reference px (Panel.asset scales like the uGUI canvas). */
.screen {
    flex-grow: 1;
}

/* main-menu.md 9: one left-centre anchor; the block is about 600 px tall and 680 wide (Korean display font sets the title about 620 wide). The castle keeps the rest of the screen. */
.block {
    position: absolute;
    left: 144px;
    top: 50%;
    margin-top: -300px;
    width: 680px;
    align-items: flex-start;
}

.crest {
    width: 118px;
    height: 100px;
    margin-left: -10px;
}

.kicker {
    margin-top: 20px;
    font-size: 20px;
    letter-spacing: 12px;
    color: var(--muted);
}

.title {
    margin-top: 2px;
    width: 100%;
    font-size: 64px;
    color: var(--bone);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.break {
    margin-top: 10px;
    margin-left: -20px;
    width: 460px;
    height: 20px;
}

.cards {
    margin-top: 40px;
}

/* A row, not a card: the selected one gets a steel bar on the left and a dark band behind. */
.card {
    width: 480px;
    height: 92px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color;
    transition-duration: 0.08s;
}

.card.on {
    border-left-color: var(--steel);
    background-color: rgba(18, 19, 26, 0.7);
}

.card-icon {
    position: absolute;
    left: 26px;
    top: 22px;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--dim);
}

.card.on .card-icon {
    -unity-background-image-tint-color: var(--steel);
}

.card-name {
    position: absolute;
    left: 96px;
    top: 10px;
    height: 44px;
    font-size: 32px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.card.on .card-name {
    color: var(--bone);
}

.card-meta {
    position: absolute;
    left: 96px;
    top: 54px;
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.card-meta > .value {
    margin: 0 20px 0 0;
}

.languages {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: row;
}

.lang {
    margin-left: 16px;
    padding: 0 0 2px 0;
    font-size: 14px;
    color: var(--dim);
    border-bottom-width: 0;
}

.lang.current {
    color: var(--bone);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: var(--steel);
}
