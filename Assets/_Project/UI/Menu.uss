/* docs/ui/main-menu.md. Sizes are 1920x1080 reference px (Panel.asset scales like the uGUI canvas). */
.screen {
    flex-grow: 1;
}

/* main-menu.md 9: one left-centre anchor; the block is about 600 px tall and 760 wide (Hahmlet Bold sets "VAMPIRE SPAWN" about 690 wide). The castle keeps the rest of the screen. */
.block {
    position: absolute;
    left: 144px;
    top: 50%;
    margin-top: -300px;
    width: 760px;
    align-items: flex-start;
}

.crest {
    width: 118px;
    height: 100px;
    margin-left: -10px;
}

.kicker {
    margin-top: 20px;
    font-size: 20px;
    letter-spacing: 12px;
    color: var(--muted);
}

.title {
    margin-top: 2px;
    width: 100%;
    font-size: 64px;
    color: var(--bone);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--ink);
}

.break {
    margin-top: 10px;
    margin-left: -20px;
    width: 460px;
    height: 20px;
}

.cards {
    margin-top: 40px;
}

/* A row, not a card: the selected one gets a steel bar on the left and a dark band behind. */
.card {
    width: 480px;
    height: 92px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color;
    transition-duration: 0.08s;
}

.card.on {
    border-left-color: var(--steel);
    background-color: rgba(18, 19, 26, 0.7);
}

.card-icon {
    position: absolute;
    left: 26px;
    top: 22px;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--dim);
}

.card.on .card-icon {
    -unity-background-image-tint-color: var(--steel);
}

.card-name {
    position: absolute;
    left: 96px;
    top: 10px;
    height: 44px;
    font-size: 32px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

.card.on .card-name {
    color: var(--bone);
}

.card-meta {
    position: absolute;
    left: 96px;
    top: 54px;
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.card-meta > .value {
    margin: 0 20px 0 0;
}

.languages {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: row;
}

.lang {
    margin-left: 16px;
    padding: 0 0 2px 0;
    font-size: 14px;
    color: var(--dim);
    border-bottom-width: 0;
}

.lang:hover {
    color: var(--bone);
}

/* docs/ui/settings.md 9-12. */
.settings-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 19, 26, 0.6);
}

.settings {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 640px;
    translate: -50% -50%;
    padding: 32px;
    -unity-slice-scale: 0.111px;
}

.settings-title {
    height: 40px;
    margin: 0 0 16px 0;
    padding: 0;
    font-size: 26px;
    color: var(--bone);
    -unity-text-align: middle-center;
}

.settings-row {
    height: 56px;
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.settings-name {
    margin: 0;
    padding: 0;
    font-size: 17px;
    color: var(--bone);
}

.settings-values {
    flex-direction: row;
}

.settings-value {
    height: 40px;
    min-width: 96px;
    margin-left: 8px;
    padding: 0 12px;
}

.settings-close {
    align-self: center;
    width: 180px;
    height: 44px;
    margin-top: 12px;
}

.lang.current {
    color: var(--bone);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: var(--steel);
}

.version {
    position: absolute;
    bottom: 16px;
    right: 24px;
    font-size: 12px;
    color: var(--dim);
}
