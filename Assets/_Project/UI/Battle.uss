/* docs/ui/battle-hud.md in the docs/art/ui-style.md tokens. 1920x1080 reference px, fixed sizes, one-point anchors (ui-style.md 15).
   BattleHud builds the elements and sets only what the battle state decides (colours, pictures, numbers); sizes and places are here.
   Font sizes are the ui-style.md tokens x 0.9 (TextCore draws about 10% larger, docs/dev/ui-toolkit-trial.md 4). */
.battle { flex-grow: 1; }

/* ui-style.md 1-3: the HUD keeps off a 360/150/360/190 px margin around the board (BattleFlow frames the board into it). */
.board-area { position: absolute; left: 360px; top: 150px; right: 360px; bottom: 190px; }
/* #150 C3: below the moon count and its state line, which end near 240 on the panel (the board area starts at 150). */
.banner { position: absolute; left: 0; right: 0; top: 108px; height: 48px; font-size: 29px; -unity-font-style: bold; -unity-text-align: upper-center; -unity-text-outline-width: 2px; display: none; }
.banner.shown { display: flex; }

.vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }

/* ---------- moon (ui-style.md 7) ---------- */
.moon { position: absolute; left: 50%; top: 24px; width: 112px; height: 112px; margin-left: -56px; }
.moon-disk { position: absolute; left: 12px; top: 12px; right: 12px; bottom: 12px; }
.moon-ring { position: absolute; left: -6px; top: -6px; right: -6px; bottom: -6px; }
.moon-pin { position: absolute; left: 56px; top: 56px; width: 0; height: 0; }
.moon-skull { position: absolute; left: -14px; top: -76px; width: 28px; height: 28px; }
.moon-label { position: absolute; left: 50%; top: 142px; width: 300px; margin-left: -150px; align-items: center; }
.moon-count { font-size: 26px; -unity-font-style: bold; color: var(--bone); }
.moon-state { font-size: 26px; color: var(--muted); }
.moon-state.hot { -unity-font-style: bold; }

/* ---------- corners ---------- */
/* battle-hud.md 3-4, 3-6: the wide action bar along the bottom, the round primary button inside its right end.
   Fixed 1640x236 (#150 C2·C4): a percentage shrank it with the larger HUD sizes, and the unit block needs three rows inside the frame's ~45 px rims. */
.action-bar, .action-row { position: absolute; left: 50%; width: 1640px; margin-left: -820px; bottom: 12px; height: 236px; }
.action-bar, .bar-frame { -unity-slice-scale: 0.4px; }
.bar-frame, .slot-frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.action-row { padding: 0 300px 0 560px; flex-direction: row; justify-content: center; align-items: center; }
.end-turn { position: absolute; left: 50%; bottom: 62px; width: 136px; height: 136px; margin-left: 534px; justify-content: center; align-items: center; }
.end-turn.deploy { bottom: 40px; width: 176px; height: 176px; margin-left: -88px; }
.end-turn.deploy > .end-turn-text { width: 144px; font-size: 26px; }
.end-turn-text { width: 112px; font-size: 26px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; padding: 0; margin: 0; }
.end-turn > .key { right: auto; left: 50%; bottom: 18px; translate: -50% 0; }
.end-turn > .ring-badge { position: absolute; left: 2px; top: 2px; }
.end-turn:hover { scale: 1.04 1.04; }
.end-turn.disabled:hover { scale: 1 1; }
.corner { position: absolute; left: 12px; bottom: 18px; height: 40px; flex-direction: row; align-items: flex-end; }
.corner > * { margin-right: 4px; }
.corner > .btn { width: 220px; height: 40px; }
/* #150 C3: the hint sits on a bg.panelDeep pill so the grid lines do not strike through it. */
.hint { position: absolute; left: 50%; bottom: 260px; max-width: 1400px; min-height: 34px; translate: -50% 0; padding: 10px 24px; border-radius: 27px; background-color: rgba(15, 16, 22, 0.75); font-size: 26px; color: var(--muted); -unity-text-align: middle-center; }

/* ---------- rules window (battle-hud.md 6) ---------- */
.veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(18, 19, 26, 0.85); }
.window { position: absolute; left: 50%; top: 50%; translate: -50% -50%; padding: 32px; -unity-slice-scale: 0.111px; }
.rules { width: 720px; }
.rules-title { font-size: 29px; -unity-font-style: bold; color: var(--bone); margin-bottom: 8px; }
.rules-line { font-size: 26px; color: var(--muted); white-space: normal; margin-bottom: 8px; }
.rules-close { flex-direction: row; justify-content: flex-end; }
.rules-close > .btn { width: 100px; height: 44px; }

/* ---------- deploy (battle-hud.md 2) ---------- */
.deploy-title { position: absolute; left: 24px; top: 24px; width: 340px; height: 48px; }
.stage-name { height: 48px; }
.stage-name > .ring-badge { margin-right: 12px; }
.stage-name > Label { flex-shrink: 1; font-size: 29px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.res { position: absolute; left: 50%; bottom: 232px; height: 88px; translate: -50% 0; padding: 0 28px; align-items: center; background-color: rgba(18, 19, 26, 0.75); border-radius: 44px; }
.res > .value { margin: 0 20px; }
.res .value-icon { width: 64px; height: 64px; margin-right: 10px; }
.res .value-text { font-size: 64px; -unity-font-style: bold; }
.hint.deploy { bottom: 340px; }
.fight-stats .value-icon { width: 34px; height: 34px; }
.fight-stats .value-text { font-size: 33px; }

.box { position: absolute; width: 340px; padding: 16px; -unity-slice-scale: 0.111px; }
.roster { left: 24px; bottom: 76px; width: 572px; padding: 20px; }
.box-title { font-size: 26px; -unity-font-style: bold; color: var(--bone); }
.roster > .box-title { font-size: 36px; }
.roster-row { margin-top: 10px; min-height: 92px; padding: 8px 14px; -unity-slice-scale: 0.0714px; }
.roster-icon { width: 60px; height: 60px; margin-right: 14px; flex-shrink: 0; }
.roster-info { flex-grow: 1; flex-shrink: 1; }
.roster-name { flex-grow: 1; font-size: 36px; -unity-font-style: bold; color: var(--bone); }
.roster-info .value { margin-left: 12px; }
.roster-info .value-icon { width: 30px; height: 30px; }
.roster-info .value-text { font-size: 34px; }
.roster .unit-stats .value-icon { width: 28px; height: 28px; }
.roster-row > .key { right: auto; bottom: auto; left: 4px; top: 4px; height: 30px; font-size: 26px; }
.roster .acts > .btn { width: 262px; height: 56px; margin-right: 12px; }
.roster .acts > .btn:last-child { margin-right: 0; }
.unit-stats { margin-top: 4px; }
.unit-stats > .value { margin-left: 0; margin-right: 8px; }
.unit-stats .value-icon { width: 20px; height: 20px; }
.acts { margin-top: 8px; }
.acts > .btn { width: 150px; height: 40px; margin-right: 8px; }

.brief { right: 24px; top: 24px; }
.def { margin-top: 10px; align-items: flex-start; }
.def-icon { width: 24px; height: 24px; margin-right: 10px; flex-shrink: 0; }
.def-text { flex-grow: 1; flex-shrink: 1; width: 0; font-size: 26px; color: var(--bone); white-space: normal; }

/* ---------- fight (battle-hud.md 3, 4) ---------- */
.fight-stats { position: absolute; left: 24px; top: 24px; height: 48px; }
.fight-stats > .value { margin-right: 28px; }
.alt-key { width: 52px; height: 32px; margin-right: 4px; background-color: rgba(15, 16, 22, 0.85); border-width: 1px; border-color: var(--line); font-size: 26px; color: var(--muted); -unity-text-align: middle-center; }
.alt-key.on { border-color: #c8304a; color: var(--bone); }
.alt-icon { width: 22px; height: 22px; }

.log { position: absolute; right: 24px; top: 24px; width: 320px; }
.log-head { font-size: 26px; color: var(--dim); -unity-text-align: upper-right; }
.log-lines { width: 320px; height: 400px; margin-top: 4px; padding: 10px; background-color: rgba(15, 16, 22, 0.92); border-width: 1px; border-color: var(--line); }
.log-line { margin-top: 4px; justify-content: flex-end; }
.log-lines .log-line { justify-content: flex-start; align-items: flex-start; }
.log-icon { width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0; }
.log-text { font-size: 26px; color: var(--muted); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.log-lines .log-text { white-space: normal; width: 270px; }

/* ---------- unit panels (ui-style.md 8-2) ---------- */
.unit { position: absolute; width: 340px; min-height: 190px; -unity-slice-scale: 0.111px; }
.unit.ally-side { left: 24px; bottom: 260px; }
.unit.other-side { right: 24px; bottom: 260px; }
.unit.deploy-side { right: 24px; bottom: 228px; }
.unit-body { flex-grow: 1; padding: 16px 20px 14px 20px; }
.unit-body > * { flex-shrink: 0; }
.unit.deploy-side > .unit-body { padding-bottom: 56px; }
.unit-body > * { margin-bottom: 6px; }
.unit-head { align-items: flex-end; flex-wrap: wrap; }
/* unit-detail.md 2-1: the HUD draws at 0.55, so the 40 px button is 64 here and its key keeps the 26 px floor. */
.battle .info-btn { position: absolute; width: 64px; height: 64px; }
.battle .info-btn > .icon { left: 14px; top: 6px; right: 14px; bottom: 22px; }
.battle .info-btn > .key { right: 2px; bottom: 2px; height: 28px; padding: 0 5px; font-size: 26px; }
/* At the right end of the hp and move row: the head can wrap to two lines (long names), that row is always there and empty on the right. */
.big > .info-btn { right: 0; top: -10px; }
.roster-row > .info-btn { right: 8px; bottom: 8px; }
.unit-weapon { width: 32px; height: 32px; margin-right: 10px; flex-shrink: 0; }
/* #150 C2: on screen (x0.55) names and the small numbers reach 18 px, hp and move 24 px. */
.unit-name { font-size: 33px; -unity-font-style: bold; color: var(--bone); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 10px; }
.unit-tag { font-size: 26px; color: #a650c4; }
.stat { flex-direction: row; align-items: flex-end; }
.stat-icon { width: 28px; height: 28px; margin-right: 6px; }
.big > .stat { margin-right: 22px; }
.big .stat-value { font-size: 44px; -unity-font-style: bold; }
.small > .stat { margin-right: 18px; }
.small .stat-value { font-size: 33px; -unity-font-style: bold; }
.stat-heal { margin-left: 6px; color: var(--steel); }
.warn { font-size: 26px; -unity-font-style: bold; }
.skills { font-size: 26px; color: var(--muted); }
.overhang { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.spike { position: absolute; top: -10px; width: 32px; height: 32px; }
.spike.left { left: -10px; }
.spike.right { right: -10px; }
.corner-badge { position: absolute; left: -6px; top: -6px; width: 24px; height: 24px; }
/* battle-hud.md 3-4 8 (#150 C4): the picked ally in the bar's left part, clear of its pointed end, 460 of its 1640 (28%): name and info button, the five numbers in one row, one warning line. */
.bar-unit { position: absolute; left: 50%; margin-left: -760px; bottom: 60px; width: 460px; height: 140px; justify-content: center; }
.bar-unit > * { flex-shrink: 0; }
.bar-unit > .unit-head { height: 44px; align-items: center; flex-wrap: nowrap; }
.bar-unit .unit-name { max-width: 360px; }
.bar-unit .unit-head > .info-btn { right: 0; top: -12px; }
.bar-stats { height: 54px; align-items: flex-end; }
.bar-stats > .big { margin-right: 4px; }
.bar-unit > .warn { height: 34px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recall { position: absolute; right: 16px; bottom: 12px; width: 90px; height: 32px; }

.slot, .slot-frame { -unity-slice-scale: 0.25px; }
.slot { width: 112px; height: 112px; flex-shrink: 1; margin: 0 6px; justify-content: center; align-items: center; }
.slot > .icon { width: 88px; height: 88px; }
.slot > .key { right: auto; bottom: auto; left: 8px; top: 8px; height: 22px; font-size: 26px; }
.slot.disabled { opacity: 0.35; }
.slot.passive > .icon { width: 60px; height: 60px; }

/* ---------- heads (ui-style.md 8-1, 8-3, 8-4): the bar's bottom-centre sits on the unit's head point ---------- */
.head { position: absolute; width: 72px; height: 12px; margin-left: -36px; margin-top: -12px; }
.head-back { position: absolute; left: -2px; top: -2px; width: 76px; height: 16px; background-color: rgba(18, 19, 26, 0.85); }
.cell { position: absolute; top: 0; bottom: 0; }
.divider { position: absolute; top: 0; width: 1px; height: 12px; margin-left: -0.5px; background-color: rgba(18, 19, 26, 0.55); }
.shields { position: absolute; left: -20px; top: -11px; width: 112px; height: 16px; flex-direction: row; justify-content: center; }
.shield { width: 16px; height: 16px; margin: 0 -1.5px; }
.damage { position: absolute; left: 86px; top: -8px; width: 60px; height: 28px; flex-direction: row; align-items: center; }
.damage > Label { font-size: 26px; -unity-font-style: bold; }
.damage > .icon { width: 24px; height: 24px; }
.head-name { position: absolute; left: -164px; width: 400px; white-space: nowrap; height: 18px; font-size: 26px; -unity-font-style: bold; color: var(--bone); -unity-text-align: lower-center; }
.head-hp { position: absolute; left: -24px; right: -24px; white-space: nowrap; top: 50%; height: 29px; margin-top: -14.5px; padding: 0; font-size: 26px; -unity-font-style: bold; color: var(--bone); -unity-text-align: middle-center; }
.head-mov { position: absolute; left: -64px; width: 200px; height: 24px; flex-direction: row; justify-content: center; align-items: flex-end; }
.head-mov > .icon { width: 20px; height: 20px; margin: 0 1px; }
.head-mov > Label { font-size: 26px; -unity-font-style: bold; color: #c8304a; margin-right: 1px; }
.head-target { position: absolute; left: 20px; width: 32px; height: 32px; }
/* ui-style.md 8-1 3 (#150 C3): hovered or picked, the bar grows to 29 (16 on screen) so the hp number sits inside it; BattleHud.NamedGrow matches. */
.head.named { height: 29px; margin-top: -29px; }
.head.named > .head-back { height: 33px; }
.head.named > .divider { height: 29px; }
.head.named > .damage { top: 0; }
/* ui-style.md 8-1 8 (#150 F): enemy bars end in small diamonds (11 across, 6 on screen), a spawn bar carries a fang at its left end (22, 12 on screen). */
.head-spike { position: absolute; top: 50%; width: 8px; height: 8px; margin-top: -4px; rotate: 45deg; background-color: #c8304a; border-width: 1px; border-color: rgba(18, 19, 26, 0.85); }
.head-spike.left { left: -10px; }
.head-spike.right { left: 74px; }
.head-fang { position: absolute; left: -26px; top: 50%; width: 22px; height: 22px; margin-top: -11px; }

/* ui-style.md 8-5: the vampire's bar */
.boss-head { width: 120px; height: 16px; margin-left: -60px; margin-top: -16px; }
.boss-head > .head-back { left: -3px; top: -3px; width: 126px; height: 22px; }
.boss-empty { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.boss-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #c8304a; }
.boss-tick { height: 16px; }
.boss-frame { position: absolute; left: -3px; top: -3px; width: 126px; height: 22px; -unity-slice-scale: 0.025px; }
.boss-skull { position: absolute; left: -18px; top: -6px; width: 28px; height: 28px; }
.boss-head > .shields { left: 4px; top: -16px; }
.boss-head > .damage { left: 124px; top: -6px; }
.boss-head.named { height: 29px; margin-top: -29px; }
.boss-head.named > .head-back, .boss-head.named > .boss-frame { height: 35px; }
.boss-head.named > .boss-tick { height: 29px; }
.boss-head.named > .boss-skull { top: 0; }
.boss-head.named > .damage { top: 0; }

/* ---------- result window (battle-hud.md 5) ---------- */
.over { display: none; }
.over.shown { display: flex; }
.over > .veil { background-color: rgba(18, 19, 26, 0.7); }
.over-box { width: 1040px; padding: 36px; align-items: center; }
.over-box > * { margin-bottom: 16px; }
/* uGUI fitted the crest to 150 px wide; Prefab fits the whole box, so the box is 150 wide. */
.emblem { width: 150px; height: 170px; }
.emblem > .icon { position: absolute; left: 12px; top: 22px; right: 12px; bottom: 22px; }
.over-title { font-size: 58px; -unity-font-style: bold; -unity-text-align: upper-center; }
.tally, .reward, .unlocked, .over-acts { justify-content: center; }
.reward > .value { margin: 0 18px; }
/* battle-hud.md 5-2 (#150 C1): icon and count, the name under them. */
.tally-cell { width: 220px; margin: 0 6px; align-items: center; }
.tally-name { width: 220px; margin-top: 4px; font-size: 26px; -unity-text-align: upper-center; }
.tally .value-icon { width: 30px; height: 30px; }
.tally .value-text { font-size: 26px; }
.reward .value-icon { width: 34px; height: 34px; }
.reward .value-text { font-size: 26px; }
.unlocked > * { margin: 0 5px; }
.unlocked > .icon { width: 28px; height: 28px; }
.unlocked > .new { width: 32px; height: 32px; }
.unlocked > Label { font-size: 26px; -unity-font-style: bold; color: var(--bone); }
.over-acts > .btn { height: 52px; margin: 0 5px; }

/* battle-hud.md 1: the HUD draws at 0.55 (BattleFlow.HudZoom); 26 px here is the 14 px floor on screen, also for the Theme.uss text classes. */
.value-text, .tip, .btn-text, .key, .ring-text { font-size: 26px; }
