/* docs/ui/battle-hud.md in the docs/art/ui-style.md tokens. 1920x1080 reference px, fixed sizes, one-point anchors (ui-style.md 15).
   BattleHud builds the elements and sets only what the battle state decides (colours, pictures, numbers); sizes and places are here.
   Font sizes are the ui-style.md tokens x 0.9 (TextCore draws about 10% larger, docs/dev/ui-toolkit-trial.md 4). */
.battle { flex-grow: 1; }

/* ui-style.md 1-3: the HUD keeps off a 360/150/360/190 px margin around the board (BattleFlow frames the board into it). */
.board-area { position: absolute; left: 360px; top: 150px; right: 360px; bottom: 190px; }
.banner { position: absolute; left: 0; right: 0; top: 12px; height: 48px; font-size: 29px; -unity-font-style: bold; -unity-text-align: upper-center; -unity-text-outline-width: 2px; display: none; }
.banner.shown { display: flex; }

.vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }

/* ---------- moon (ui-style.md 7) ---------- */
.moon { position: absolute; left: 50%; top: 24px; width: 112px; height: 112px; margin-left: -56px; }
.moon-disk { position: absolute; left: 12px; top: 12px; right: 12px; bottom: 12px; }
.moon-ring { position: absolute; left: -6px; top: -6px; right: -6px; bottom: -6px; }
.moon-pin { position: absolute; left: 56px; top: 56px; width: 0; height: 0; }
.coffin { position: absolute; left: -2.5px; top: -55px; width: 5px; height: 26px; background-color: var(--line); }
.moon-skull { position: absolute; left: -14px; top: -76px; width: 28px; height: 28px; }
.moon-label { position: absolute; left: 50%; top: 142px; width: 300px; margin-left: -150px; align-items: center; }
.moon-count { font-size: 18px; -unity-font-style: bold; color: var(--bone); }
.moon-state { font-size: 13px; color: var(--muted); }
.moon-state.hot { -unity-font-style: bold; }

/* ---------- corners ---------- */
.end-turn { position: absolute; right: 24px; bottom: 24px; width: 200px; height: 56px; }
.end-turn .ring-badge { position: absolute; left: 12px; top: 14px; }
.corner { position: absolute; left: 12px; bottom: 18px; height: 40px; flex-direction: row; align-items: flex-end; }
.corner > * { margin-right: 4px; }
.corner > .btn { width: 220px; height: 40px; }
.hint { position: absolute; left: 50%; bottom: 120px; width: 1000px; height: 24px; margin-left: -500px; font-size: 15px; color: var(--muted); -unity-text-align: middle-center; }

/* ---------- rules window (battle-hud.md 6) ---------- */
.veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(18, 19, 26, 0.85); }
.window { position: absolute; left: 50%; top: 50%; translate: -50% -50%; padding: 32px; -unity-slice-scale: 0.111px; }
.rules { width: 720px; }
.rules-title { font-size: 29px; -unity-font-style: bold; color: var(--bone); margin-bottom: 8px; }
.rules-line { font-size: 15px; color: var(--muted); white-space: normal; margin-bottom: 8px; }
.rules-close { flex-direction: row; justify-content: flex-end; }
.rules-close > .btn { width: 100px; height: 36px; }

/* ---------- deploy (battle-hud.md 2) ---------- */
.deploy-title { position: absolute; left: 24px; top: 24px; width: 340px; height: 110px; }
.stage-name { height: 48px; }
.stage-name > .ring-badge { margin-right: 12px; }
.stage-name > Label { flex-shrink: 1; font-size: 29px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.res { margin-top: 8px; }
.res > .value { margin-right: 24px; }
.res .value-icon, .fight-stats .value-icon { width: 28px; height: 28px; }
.res .value-text, .fight-stats .value-text { font-size: 20px; }

.box { position: absolute; width: 340px; padding: 16px; -unity-slice-scale: 0.111px; }
.roster { left: 24px; top: 154px; }
.box-title { font-size: 20px; -unity-font-style: bold; color: var(--bone); }
.roster-row { margin-top: 8px; min-height: 64px; padding: 6px 10px; -unity-slice-scale: 0.0714px; }
.roster-icon { width: 40px; height: 40px; margin-right: 10px; flex-shrink: 0; }
.roster-info { flex-grow: 1; flex-shrink: 1; }
.roster-name { flex-grow: 1; font-size: 15px; -unity-font-style: bold; color: var(--bone); }
.roster-info .value { margin-left: 10px; }
.roster-info .value-icon { width: 21px; height: 21px; }
.roster-info .value-text { font-size: 13px; }
.unit-stats { margin-top: 4px; }
.unit-stats > .value { margin-left: 0; margin-right: 8px; }
.unit-stats .value-icon { width: 20px; height: 20px; }
.acts { margin-top: 8px; }
.acts > .btn { width: 150px; height: 40px; margin-right: 8px; }

.brief { right: 24px; top: 24px; }
.def { margin-top: 10px; align-items: flex-start; }
.def-icon { width: 24px; height: 24px; margin-right: 10px; flex-shrink: 0; }
.def-text { width: 274px; font-size: 13px; color: var(--bone); white-space: normal; }

/* ---------- fight (battle-hud.md 3, 4) ---------- */
.fight-stats { position: absolute; left: 24px; top: 24px; height: 48px; }
.fight-stats > .value { margin-right: 28px; }
.alt-key { width: 34px; height: 22px; margin-right: 4px; background-color: rgba(15, 16, 22, 0.85); border-width: 1px; border-color: var(--line); font-size: 13px; color: var(--muted); -unity-text-align: middle-center; }
.alt-key.on { border-color: #c8304a; color: var(--bone); }
.alt-icon { width: 22px; height: 22px; }

.log { position: absolute; right: 24px; top: 24px; width: 320px; }
.log-head { font-size: 13px; color: var(--dim); -unity-text-align: upper-right; }
.log-lines { width: 320px; height: 400px; margin-top: 4px; padding: 10px; background-color: rgba(15, 16, 22, 0.92); border-width: 1px; border-color: var(--line); }
.log-line { margin-top: 4px; justify-content: flex-end; }
.log-lines .log-line { justify-content: flex-start; align-items: flex-start; }
.log-icon { width: 16px; height: 16px; margin-right: 6px; flex-shrink: 0; }
.log-text { font-size: 15px; color: var(--muted); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.log-lines .log-text { white-space: normal; width: 270px; }

/* ---------- unit panels (ui-style.md 8-2) ---------- */
.unit { position: absolute; width: 340px; height: 190px; -unity-slice-scale: 0.111px; }
.unit.ally-side { left: 24px; bottom: 72px; }
.unit.other-side { right: 240px; bottom: 72px; }
.unit.deploy-side { right: 24px; bottom: 124px; }
.unit-body { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 16px 20px 14px 20px; }
.unit-body > * { margin-bottom: 6px; }
.unit-head { align-items: flex-end; }
.unit-weapon { width: 26px; height: 26px; margin-right: 10px; flex-shrink: 0; }
.unit-name { font-size: 20px; -unity-font-style: bold; color: var(--bone); flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; margin-right: 10px; }
.unit-tag { font-size: 13px; color: #a650c4; }
.stat { flex-direction: row; align-items: flex-end; }
.stat-icon { width: 24px; height: 24px; margin-right: 6px; }
.big > .stat { margin-right: 22px; }
.big .stat-value { font-size: 31px; -unity-font-style: bold; }
.small > .stat { margin-right: 18px; }
.small .stat-value { font-size: 18px; -unity-font-style: bold; }
.stat-heal { margin-left: 6px; color: var(--steel); }
.warn { font-size: 13px; -unity-font-style: bold; }
.skills { font-size: 13px; color: var(--muted); }
.overhang { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.spike { position: absolute; top: -10px; width: 32px; height: 32px; }
.spike.left { left: -10px; }
.spike.right { right: -10px; }
.corner-badge { position: absolute; left: -6px; top: -6px; width: 24px; height: 24px; }
.recall { position: absolute; right: 16px; bottom: 12px; width: 90px; height: 32px; }

.actions { position: absolute; left: 50%; bottom: 24px; height: 84px; translate: -50% 0; flex-direction: row; align-items: flex-end; }
.slot { width: 64px; height: 64px; margin: 0 13px; justify-content: center; align-items: center; -unity-slice-scale: 0.0714px; }
.slot > .icon { width: 40px; height: 40px; }

/* ---------- heads (ui-style.md 8-1, 8-3, 8-4): the bar's bottom-centre sits on the unit's head point ---------- */
.head { position: absolute; width: 72px; height: 12px; margin-left: -36px; margin-top: -12px; }
.head-back { position: absolute; left: -2px; top: -2px; width: 76px; height: 16px; background-color: rgba(18, 19, 26, 0.85); }
.cell { position: absolute; top: 0; bottom: 0; }
.divider { position: absolute; top: 0; width: 1px; height: 12px; margin-left: -0.5px; background-color: rgba(18, 19, 26, 0.55); }
.shields { position: absolute; left: -20px; top: -11px; width: 112px; height: 16px; flex-direction: row; justify-content: center; }
.shield { width: 16px; height: 16px; margin: 0 -1.5px; }
.damage { position: absolute; left: 76px; top: -8px; width: 60px; height: 28px; flex-direction: row; align-items: center; }
.damage > Label { font-size: 18px; -unity-font-style: bold; }
.damage > .icon { width: 24px; height: 24px; }
.head-name { position: absolute; left: -84px; width: 240px; height: 18px; font-size: 13px; -unity-font-style: bold; color: var(--bone); -unity-text-align: lower-center; }
.head-hp { position: absolute; left: 0; right: 0; top: 50%; height: 20px; margin-top: -10px; padding: 0; font-size: 14px; -unity-font-style: bold; color: var(--bone); -unity-text-align: middle-center; }
.head-mov { position: absolute; left: -64px; width: 200px; height: 24px; flex-direction: row; justify-content: center; align-items: flex-end; }
.head-mov > .icon { width: 20px; height: 20px; margin: 0 1px; }
.head-mov > Label { font-size: 18px; -unity-font-style: bold; color: #c8304a; margin-right: 1px; }
.head-target { position: absolute; left: 20px; width: 32px; height: 32px; }

/* ui-style.md 8-5: the vampire's bar */
.boss-head { width: 120px; height: 16px; margin-left: -60px; margin-top: -16px; }
.boss-head > .head-back { left: -3px; top: -3px; width: 126px; height: 22px; }
.boss-empty { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.boss-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #c8304a; }
.boss-tick { height: 16px; }
.boss-frame { position: absolute; left: -3px; top: -3px; width: 126px; height: 22px; -unity-slice-scale: 0.025px; }
.boss-skull { position: absolute; left: -18px; top: -6px; width: 28px; height: 28px; }
.boss-head > .shields { left: 4px; top: -16px; }
.boss-head > .damage { left: 124px; top: -6px; }

/* ---------- result window (battle-hud.md 5) ---------- */
.over { display: none; }
.over.shown { display: flex; }
.over > .veil { background-color: rgba(18, 19, 26, 0.7); }
.over-box { width: 640px; padding: 36px; align-items: center; }
.over-box > * { margin-bottom: 16px; }
/* uGUI fitted the crest to 150 px wide; Prefab fits the whole box, so the box is 150 wide. */
.emblem { width: 150px; height: 170px; }
.emblem > .icon { position: absolute; left: 12px; top: 22px; right: 12px; bottom: 22px; }
.over-title { font-size: 58px; -unity-font-style: bold; -unity-text-align: upper-center; }
.tally, .reward, .unlocked, .over-acts { justify-content: center; }
.tally > .value, .reward > .value { margin: 0 18px; }
.tally .value-icon { width: 30px; height: 30px; }
.tally .value-text { font-size: 22px; }
.reward .value-icon { width: 34px; height: 34px; }
.reward .value-text { font-size: 25px; }
.unlocked > * { margin: 0 5px; }
.unlocked > .icon { width: 28px; height: 28px; }
.unlocked > .new { width: 32px; height: 32px; }
.unlocked > Label { font-size: 18px; -unity-font-style: bold; color: var(--bone); }
.over-acts > .btn { height: 52px; margin: 0 5px; }
