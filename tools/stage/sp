#!/bin/bash
# tools/stage/sp <command> ... : headless stage player (docs/dev/stage-tools.md). Builds on first use.
D="$(cd "$(dirname "$0")" && pwd)"
E="$D/bin/Debug/net9.0/StagePlay.exe"
[ -x "$E" ] && [ -z "$SP_BUILD" ] || dotnet build "$D/StagePlay.csproj" -nologo -v q >/dev/null || exit 1
SP_DIR="$D" "$E" "$@"
